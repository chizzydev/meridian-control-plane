                            "@types/react-dom":  "^19",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.3.3",
                            "tailwindcss":  "^4",
                            "tsx":  "4.23.13",
                            "typescript":  "^5",
                            "vitest":  "4.1.11"
                        }
}
